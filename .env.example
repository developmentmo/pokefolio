# PokeFolio local configuration. Copy to .env and fill in. Never commit .env.

# PostgreSQL
POKEFOLIO_DB_USER=pokefolio
POKEFOLIO_DB_PASSWORD=change-me

# HMAC secret for access tokens, at least 32 random bytes.
# Generate with: openssl rand -base64 48
POKEFOLIO_JWT_SECRET=

# Origins allowed to call the API from a browser (Flutter web). Comma separated, wildcards allowed.
POKEFOLIO_ALLOWED_ORIGINS=http://localhost:*

# Card/price provider: mock (default). pokemon-api stays disabled until its contract is verified.
POKEFOLIO_PROVIDER=mock
# Backend-only API key for pokemon-api.com. Never put it in the Flutter app.
POKEMON_API_KEY=

# URL the Flutter web build uses to reach the backend
POKEFOLIO_PUBLIC_API_URL=http://localhost:8080

# Optional Maven Central mirror for Docker builds in restricted networks
MAVEN_MIRROR_URL=
